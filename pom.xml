<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.zhangxian</groupId>
    <artifactId>xian-master</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>xian-master</name>
    <description>parent</description>
    <packaging>pom</packaging>
    <modules>
        <module>xian-dependencies</module>
        <module>xian-common</module>
        <module>xian-webapp</module>
        <module>xian-redisapp</module>
        <module>xian-ai</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.0.5</version>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 开发环境 Profile -->
        <profile>
            <id>dev</id>
            <properties>
                <!-- 当激活 dev profile 时，将 profiles.active 的值设为 dev -->
                <profiles.active>dev</profiles.active>
            </properties>
            <!-- 可以将此 profile 设为默认激活 -->
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>

        <!-- 测试环境 Profile -->
        <profile>
            <id>test</id>
            <properties>
                <profiles.active>test</profiles.active>
            </properties>
        </profile>

        <!-- 生产环境 Profile -->
        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>
            </properties>
        </profile>
    </profiles>

</project>
